# Flask
SECRET_KEY="dev-secret-key-change-in-production"
DEBUG=true

# GA parameters
GA_POPULATION_SIZE=150
GA_MAX_GENERATIONS=500
GA_MUTATION_RATE=0.20
GA_CROSSOVER_RATE=0.80
GA_ELITE_SIZE=10
GA_TOURNAMENT_SIZE=7

# Job settings
JOB_TIMEOUT=600
JOB_CLEANUP_DAYS=7
MAX_CONCURRENT_JOBS=2

# PostgreSQL
# Docker: postgres:5432 (service name in docker-compose)
# Local dev: localhost:5432
POSTGRES_HOST=postgres:5432
POSTGRES_DB=schedool
POSTGRES_USER=schedool
POSTGRES_PASSWORD=
