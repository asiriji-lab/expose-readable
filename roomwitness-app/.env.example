# RoomWitness app — runtime config. Copy to `.env` and adjust.
# Expo inlines variables prefixed with EXPO_PUBLIC_ at build time.

# Base URL of the backend portal (no trailing slash). Use your machine's LAN IP
# (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_BASE=http://192.168.1.100:5001

# Set to "false" to hit the real backend. Anything else (or unset) uses bundled mock data.
EXPO_PUBLIC_USE_MOCK=true
